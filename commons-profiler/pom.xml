<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.navercorp.pinpoint</groupId>
        <artifactId>pinpoint</artifactId>
        <version>2.5.3</version>
    </parent>

    <artifactId>pinpoint-commons-profiler</artifactId>
    <name>pinpoint-commons-profiler</name>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>com.navercorp.pinpoint</groupId>
            <artifactId>pinpoint-commons</artifactId>
        </dependency>
        <dependency>
            <groupId>com.navercorp.pinpoint</groupId>
            <artifactId>pinpoint-commons-buffer</artifactId>
        </dependency>

        <!-- Logging dependencies -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-jcl</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>


    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.logging.log4j</groupId>
                        <artifactId>log4j-transform-maven-shade-plugin-extensions</artifactId>
                        <version>0.2.0</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <transformers>
                        <!-- 合并META-INF/services下的文件 -->
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                        <transformer implementation="org.apache.logging.log4j.maven.plugins.shade.transformer.Log4j2PluginCacheFileTransformer"/>
                    </transformers>
                    <filters>
                        <filter>
                            <artifact>*:*</artifact>
                            <excludes>
                                <exclude>META-INF/*.SF</exclude>
                                <exclude>META-INF/*.DSA</exclude>
                                <exclude>META-INF/*.RSA</exclude>
                            </excludes>
                        </filter>
                    </filters>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <relocations>
                                <relocation>
                                    <pattern>com</pattern>
                                    <shadedPattern>graalvm.image.com</shadedPattern>
                                    <excludes>
                                        <exclude>com.navercorp.**</exclude>
                                        <exclude>com.sun.management.**</exclude>
                                    </excludes>
                                </relocation>
                                <relocation>
                                    <pattern>io</pattern>
                                    <shadedPattern>graalvm.image.io</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>android</pattern>
                                    <shadedPattern>graalvm.image.android</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org</pattern>
                                    <shadedPattern>graalvm.image.org</shadedPattern>
                                    <excludes>
                                        <exclude>org.xml.sax.**</exclude>
                                        <exclude>org.w3c.dom.**</exclude>
                                        <exclude>org.ietf.jgss.**</exclude>
                                        <exclude>org.jcp.xml.**</exclude>
                                    </excludes>
                                </relocation>
                                <relocation>
                                    <pattern>google</pattern>
                                    <shadedPattern>graalvm.image.google</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>javax</pattern>
                                    <shadedPattern>graalvm.image.javax</shadedPattern>
                                    <excludes>
                                        <exclude>javax.management.**</exclude>
                                        <exclude>javax.crypto.**</exclude>
                                        <exclude>javax.net.**</exclude>
                                        <exclude>javax.security.**</exclude>
                                        <exclude>javax.naming.**</exclude>
                                        <exclude>javax.xml.**</exclude>
                                        <exclude>javax.sql.**</exclude>
                                        <exclude>javax.transaction.xa.**</exclude>
                                        <exclude>javax.script.**</exclude>
                                        <exclude>javax.tools.**</exclude>
                                        <exclude>javax.lang.model.**</exclude>
                                        <exclude>javax.annotation.processing.**</exclude>
                                        <exclude>javax.imageio.**</exclude>
                                        <exclude>javax.print.**</exclude>
                                        <exclude>javax.sound.**</exclude>
                                        <exclude>javax.swing.**</exclude>
                                        <exclude>javax.accessibility.**</exclude>
                                        <exclude>javax.rmi.**</exclude>
                                        <exclude>javax.smartcardio.**</exclude>
                                    </excludes>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
